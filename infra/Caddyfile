# Reverse proxy + automatic TLS (Let's Encrypt) for the two prod hosts.
# DOMAIN and ADMIN_EMAIL are passed to the caddy container via a scoped
# environment: block in docker-compose.prod.yml (not the full .env.prod
# env_file — caddy doesn't need DATABASE_URL/JWT_SECRET/S3 keys/etc.).

{
	email {$ADMIN_EMAIL}
}

app.{$DOMAIN} {
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	reverse_proxy api:3001
}
